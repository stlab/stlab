# Standard comes from the compile command (CMake); -std=c++17 here would be
# wrong when using clang-cl (clang-tidy-win64 on Windows) which expects /std:c++17.
Checks: >
  cert-*,
  performance-*,
  modernize-*,
  misc-include-cleaner,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -modernize-use-trailing-return-type,
  -cert-err58-cpp
CheckOptions:
  - key: misc-include-cleaner.IgnoreHeaders
    value: >
      boost/test/.*;
      __chrono/.*
HeaderFilterRegex: "^.*/include/stlab/.*$"
# Exclude third-party and system headers from diagnostics (doctest, CPM cache, Program Files).
ExcludeHeaderFilterRegex: "^.*(doctest|\\.cache[/\\\\]cpm|Program Files).*$"
# WarningsAsErrors: "*"
