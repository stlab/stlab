#ifndef STLAB_CONFIG_HPP
#define STLAB_CONFIG_HPP

/*! @file config.hpp
 *  @brief STLab version and coroutine configuration; includes execution configuration.
 */

#include <stlab/execution/config.hpp>

#define STLAB_VERSION_MAJOR() @PROJECT_VERSION_MAJOR@
#define STLAB_VERSION_MINOR() @PROJECT_VERSION_MINOR@
#define STLAB_VERSION_PATCH() @PROJECT_VERSION_PATCH@

#define STLAB_VERSION_NAMESPACE() \
    v@PROJECT_VERSION_MAJOR@_@PROJECT_VERSION_MINOR@_@PROJECT_VERSION_PATCH@
#define STLAB_VERSION_NAMESPACE_BEGIN() inline namespace STLAB_VERSION_NAMESPACE() {
#define STLAB_VERSION_NAMESPACE_END() } /* inline version */

#cmakedefine01 STLAB_STD_COROUTINES()

#endif // STLAB_CONFIG_HPP
